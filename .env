# Hardhat Node URL (default: http://127.0.0.1:8545)
HARDHAT_NETWORK_URL=http://127.0.0.1:8545

# Private key for deploying contracts (replace with your own if deploying to testnet)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional: Infura or Alchemy Project ID if using those providers
# INFURA_PROJECT_ID=your-infura-project-id
# ALCHEMY_API_KEY=your-alchemy-api-key

# Optional: Etherscan API Key for contract verification 
# ETHERSCAN_API_KEY=your-etherscan-api-key
